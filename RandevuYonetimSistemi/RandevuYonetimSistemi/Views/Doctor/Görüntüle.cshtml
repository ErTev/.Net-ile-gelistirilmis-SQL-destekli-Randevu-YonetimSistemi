@model List<RandevuYonetimSistemi.Models.Doctor>

@{
    ViewData["Title"] = "Doktor Listesi";
}

<h2>Doktor Listesi</h2>

<table class="table table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>Adı</th>
            <th>Soyadı</th>
            <th>TC</th>
            <th>Email</th>
            <th>Telefon</th>
            <th>Ünvan</th>
            <th>Çalışma Durumu</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model)
        {
            <tr>
                <td>@doctor.Adi</td>
                <td>@doctor.Soyadi</td>
                <td>@doctor.Tc</td>
                <td>@doctor.Email</td>
                <td>@doctor.Telefon</td>
                <td>@doctor.Unvan</td>
                <td>@doctor.Aktiflik</td>
                <td>
                    <a asp-action="Güncelle" asp-route-id="@doctor.Id" class="btn btn-warning btn-sm">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="DoktorEkle" class="btn btn-success">Yeni Doktor Ekle</a>
